{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    "noEmit": true,
    "module": "commonjs",
    "target": "esnext",
    "types": ["node"],
    "noUncheckedIndexedAccess": true,
    "strict": true,
    "jsx": "react-jsx",
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "paths": {
      "@constants/*": ["./constants/*"],
      "@fixtures/*": ["./fixtures/*"],
      "@pages/*": ["./pages/*"]
    }
  }
}
